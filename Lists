print("\n=== ЗАДАЧИ НА СПИСКИ ===")

# 1. Первый и последний элементы, поменять местами
lst1 = [10, 20, 30, 40, 50]
print("1 (до):", lst1[0], lst1[-1])
lst1[0], lst1[-1] = lst1[-1], lst1[0]
print("1 (после):", lst1)

# 2. Элемент в середине списка
lst2 = [1, 2, 3, 4, 5, 6]
mid2 = len(lst2) // 2
if len(lst2) % 2 == 0:
    print("2 (четная):", lst2[mid2-1], lst2[mid2])
else:
    print("2 (нечетная):", lst2[mid2])

# 3. Из списка 10 чисел: первые 3, последние 3, четные индексы, обратный порядок
lst3 = list(range(1, 11))
print("3 (первые 3):", lst3[:3])
print("3 (последние 3):", lst3[-3:])
print("3 (четные индексы):", lst3[::2])
print("3 (обратный порядок):", lst3[::-1])

# 4. Пустой список. Добавить 3 в конец, число в начало, удалить последний.
lst4 = []
lst4.append(10)
lst4.append(20)
lst4.append(30)
lst4.insert(0, 5)
lst4.pop()
print("4:", lst4)

# 5. Длина, сумма, мин, макс, среднее арифметическое
lst5 = [5, 10, 15, 20, 25]
print("5 (длина):", len(lst5))
print("5 (сумма):", sum(lst5))
print("5 (мин/макс):", min(lst5), max(lst5))
print("5 (среднее):", sum(lst5) / len(lst5))

# 6. Есть ли число x, сколько раз, индекс первого вхождения
lst6 = [1, 2, 3, 2, 4, 2, 5]
x = 2
print("6 (есть ли):", x in lst6)
print("6 (сколько раз):", lst6.count(x))
print("6 (индекс):", lst6.index(x))

# 7. Три наименьших и три наибольших элемента (не меняя исходный)
lst7 = [10, 5, 8, 1, 9, 3, 7, 2, 6, 4]
sorted_lst7 = sorted(lst7)
print("7 (три наименьших):", sorted_lst7[:3])
print("7 (три наибольших):", sorted_lst7[-3:])

# 8. Два списка. Объединить, отсортировать по убыванию, вывести второй по величине.
list_a = [1, 5, 3]
list_b = [8, 2, 9]
combined = list_a + list_b
combined.sort(reverse=True)
print("8 (второй по величине):", combined[1]) # Индекс 1 - это второй элемент

# 9. Строка -> список слов, сортировка по алфавиту, сборка через запятую.
s9 = "яблоко банан апельсин"
words9 = s9.split()
words9.sort()
result9 = ",".join(words9) # join собирает строку из списка
print("9:", result9)

# 10. Сдвинуть элементы списка на k позиций вправо.
lst10 = [1, 2, 3, 4, 5]
k = 2
shifted = lst10[-k:] + lst10[:-k]
print("10:", shifted)
