# 19. Дано число n. Выведите все числа Фибоначчи, не превышающие n.
n = int(input("Введите n: "))
a, b = 0, 1
while a <= n:
    print(a)
    a, b = b, a + b

# 20. Программа загадывает число от 1 до 100. Пользователь угадывает его, а программа отвечает «больше» или «меньше». В конце выведите количество попыток.
secret = random.randint(1, 100)
attempts = 0
guess = 0
while guess != secret:
    guess = int(input("Угадайте число от 1 до 100: "))
    attempts += 1
    if guess < secret:
        print("Больше")
    elif guess > secret:
        print("Меньше")
print(f"Количество попыток: {attempts}")
