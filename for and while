# 12. Вводите числа, пока не будет введён 0. Выведите сумму введённых чисел.
s = 0
n = int(input("Введите число (0 для выхода): "))
while n != 0:
    s += n
    n = int(input("Введите число (0 для выхода): "))
print(s)

# 13. Дано натуральное число. Посчитайте количество его цифр.
n = int(input("Введите натуральное число: "))
count = 0
while n > 0:
    count += 1
    n //= 10
print(count)

# 14. Дано натуральное число. Найдите сумму его цифр.
n = int(input("Введите натуральное число: "))
s = 0
while n > 0:
    s += n % 10
    n //= 10
print(s)

# 15. Дано натуральное число. Выведите его цифры в обратном порядке одним числом.
n = int(input("Введите натуральное число: "))
rev = 0
while n > 0:
    rev = rev * 10 + n % 10
    n //= 10
print(rev)

