print("=== ЗАДАЧИ НА СТРОКИ ===")

# 1. Длина, первый и последний символы
s1 = "Программирование"
print("1:", len(s1), s1[0], s1[-1])

# 2. Символ в середине (и два средних для четной длины)
s2 = "Python"
mid = len(s2) // 2
if len(s2) % 2 == 0:
    print("2 (четная):", s2[mid-1], s2[mid])
else:
    print("2 (нечетная):", s2[mid])

# 3. Первые 3, последние 3, четные индексы, обратный порядок
s3 = "abcdefgh"
print("3 (первые 3):", s3[:3])
print("3 (последние 3):", s3[-3:])
print("3 (четные индексы):", s3[::2])
print("3 (обратный порядок):", s3[::-1])

# 4. Верхний, нижний регистр и с заглавной буквы
s4 = "hello world"
print("4:", s4.upper(), s4.lower(), s4.capitalize()) 

# 5. Есть ли символ 'c', сколько раз, индекс первого вхождения
s5 = "abracadabra"
c = "a"
print("5 (есть ли):", c in s5)
print("5 (сколько раз):", s5.count(c))
print("5 (индекс):", s5.find(c))

# 6. Заменить пробелы на подчеркивания
s6 = "Я учу питон"
print("6:", s6.replace(" ", "_"))

# 7. Удалить пробелы в начале и конце, вывести длину
s7 = "   пробелы вокруг   "
s7_clean = s7.strip()
print("7 (длина):", len(s7_clean))

# 8. Имя и фамилия. Фамилия, имя, инициалы.
s8 = "Иван Иванов"
parts = s8.split()
print("8 (Фамилия Имя):", parts[1], parts[0])
print("8 (Инициалы):", parts[1][0] + ". " + parts[0][0] + ".")

# 9. Палиндром без учета регистра
s9 = "А роза упала на лапу Азора"
s9_lower = s9.lower().replace(" ", "")
if s9_lower == s9_lower[::-1]:
    print("9: Является палиндромом")
else:
    print("9: Не является палиндромом")

# 10. Количество слов, первое и последнее слово
s10 = "Это строка из нескольких слов"
words = s10.split()
print("10 (кол-во слов):", len(words))
print("10 (первое и последнее):", words[0], words[-1])
