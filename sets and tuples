# ЗАДАНИЯ: МНОЖЕСТВА

# 1. Создайте множество из списка с повторяющимися числами. Выведите множество и количество его элементов.
lst = [1, 2, 2, 3, 4, 4, 5]
s = set(lst)
print(s)
print(len(s))

# 2. Создайте множество из трёх чисел. Добавьте в него новый элемент, затем удалите один из имеющихся и выведите результат.
s = {1, 2, 3}
s.add(4)
s.remove(1)
print(s)

# 3. Даны два множества. Выведите их объединение.
s1 = {1, 2, 3}
s2 = {3, 4, 5}
print(s1 | s2)

# 4. Даны два множества. Выведите их пересечение.
print(s1 & s2)

# 5. Даны два множества. Выведите элементы первого, которых нет во втором, и элементы второго, которых нет в первом.
print(s1 ^ s2)

# 6. Даны два множества. Выведите элементы, которые входят ровно в одно из них.
print(s1 ^ s2)

# 7. Дано множество и число x. Выведите, есть ли x в множестве.
x = 3
print(x in s1)

# 8. Даны два множества. Определите, является ли первое подмножеством второго.
print(s1.issubset(s2))

# 9. Дана строка. Выведите множество различных символов этой строки и их количество.
text = "hello"
chars = set(text)
print(chars)
print(len(chars))

# 10. Даны два списка. Выведите отсортированный список их общих элементов без повторов.
l1 = [1, 2, 3, 4]
l2 = [3, 4, 5, 6]
print(sorted(list(set(l1) & set(l2))))


# ЗАДАНИЯ: КОРТЕЖИ

# 1. Создайте кортеж из пяти чисел. Выведите его первый, последний и средний элементы.
t = (10, 20, 30, 40, 50)
print(t[0])
print(t[-1])
print(t[2])

# 2. Из кортежа из восьми чисел получите: первые два элемента, последние два, кортеж в обратном порядке.
t = (1, 2, 3, 4, 5, 6, 7, 8)
print(t[:2])
print(t[-2:])
print(t[::-1])

# 3. Дан кортеж чисел. Выведите его длину, сумму, минимум и максимум.
t = (5, 2, 8, 1, 9)
print(len(t))
print(sum(t))
print(min(t))
print(max(t))

# 4. Дан кортеж и число x. Выведите, есть ли x в кортеже, сколько раз оно встречается и индекс первого вхождения.
t = (1, 2, 2, 3, 4, 2)
x = 2
print(x in t)
print(t.count(x))
print(t.index(x))

# 5. Даны два кортежа. Объедините их в один и выведите результат.
t1 = (1, 2)
t2 = (3, 4)
print(t1 + t2)

# 6. Создайте кортеж из одного элемента и выведите его тип.
t = (5,)
print(type(t))

# 7. Дан кортеж из имени, возраста и города. Распакуйте его в три переменные и выведите каждую.
t = ("Иван", 25, "Москва")
name, age, city = t
print(name)
print(age)
print(city)

# 8. Даны две переменные. Поменяйте их значения местами с помощью кортежа.
a = 10
b = 20
a, b = b, a
print(a, b)

# 9. Дан кортеж. Замените в нём второй элемент на другое значение и выведите новый кортеж.
t = (1, 2, 3)
new_t = t[:1] + (99,) + t[2:]
print(new_t)

# 10. Дан кортеж чисел с повторами. Получите кортеж из тех же чисел без повторов, отсортированный по возрастанию.
t = (3, 1, 2, 3, 4, 1, 5)
new_t = tuple(sorted(set(t)))
print(new_t)
